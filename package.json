{
  "name": "token-billing",
  "version": "0.1.0",
  "type": "module",
  "description": "Trace Claude Code session spend to whatever put the tokens in context",
  "license": "MIT",
  "homepage": "https://token-billing.vercel.app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HerringtonDarkholme/token-cost.git"
  },
  "bugs": "https://github.com/HerringtonDarkholme/token-cost/issues",
  "keywords": ["claude-code", "claude", "cost", "billing", "token", "cli"],
  "packageManager": "pnpm@10.8.0",
  "bin": {
    "token-billing": "./bin/cli.ts"
  },
  "files": ["bin/cli.ts", "src/engine.ts"],
  "scripts": {
    "dev": "vite",
    "cli": "node bin/cli.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run test:engine && pnpm run test:model && pnpm run test:transfer && pnpm run test:render",
    "test:engine": "node test/engine.test.ts",
    "test:model": "node test/model.test.ts",
    "test:transfer": "node test/transfer.test.ts",
    "test:render": "vitest run",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run build && pnpm run test"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "happy-dom": "^20.11.2",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@number-flow/react": "^0.6.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
