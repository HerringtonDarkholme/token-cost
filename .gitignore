# Transcripts and anything derived from them. This app's whole input is private session
# data; none of it belongs in version control. Keep these patterns even if you never
# intend to put a transcript here -- the point is that an accident is not committable.
*.jsonl
.claude/
projects/
transcripts/
report_data.json
*.report.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Node / Vite. cost-report.html is deliberately NOT ignored: it is the deliverable, the
# thing a reader downloads and double-clicks. dist/ is only the build's staging area.
node_modules/
dist/
.vite/
*.log

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp
