{
  /* Type-checking only. Vite (Rolldown/esbuild) does the transpiling for the browser, and
     Node 24 strips types directly for the test suites -- so `tsc` never emits here, it
     only judges. `pnpm typecheck` is the gate. */
  "compilerOptions": {
    "target": "es2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["node"],

    /* The automatic runtime: components import nothing to write JSX, and the transform
       Vite applies in the browser is the one `tsc` type-checks against here. */
    "jsx": "react-jsx",

    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,

    /* Nothing that Node's type stripper cannot erase: no enums, no namespaces, no
       parameter properties. This is what keeps `node test/engine.test.ts` and
       `node test/model.test.ts` working with no build step and no test-runner dependency
       -- the property that lets those suites take a real transcript directory as an
       argument. (The render suite needs a DOM and a JSX transform, so it runs under
       Vitest instead.) */
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    /* Relative imports carry their real `.ts` extension. Node's stripper does no
       extension resolution, so `./engine` would not resolve there; `./engine.ts` is the
       one specifier both Node and Vite accept. */
    "allowImportingTsExtensions": true,
    "noEmit": true,

    "skipLibCheck": true
  },
  /* `*.ts` at the root is the two Vite configs, which are type-checked like anything else.
     The app itself is under `src/`; the suites stay a peer of it rather than inside it; `bin/`
     is the CLI, a Node entry point that imports the engine rather than living inside it. */
  "include": ["*.ts", "src/**/*.ts", "src/**/*.tsx", "test/**/*.ts", "test/**/*.tsx", "bin/**/*.ts"]
}
